# Copy to .env and fill in. NEVER commit the real .env file.

# --- Database ---
DATABASE_URL="postgresql://taleemos:CHANGE_ME@localhost:5432/taleemos_dev?schema=public"

# --- Application ---
APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_LONG_RANDOM_STRING"
DEFAULT_TIMEZONE="Asia/Karachi"

# --- First Super Admin bootstrap (used once by `npm run bootstrap:superadmin`) ---
# Remove these from the environment after the first admin exists.
BOOTSTRAP_SUPERADMIN_EMAIL=""
BOOTSTRAP_SUPERADMIN_PASSWORD=""

# --- Email (optional: when unset, emails are recorded as NOT_SENT, never as delivered) ---
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""

# --- SMS / WhatsApp (optional, requires an authorized provider account) ---
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""

# --- Object storage (S3-compatible, optional until file uploads are enabled) ---
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
